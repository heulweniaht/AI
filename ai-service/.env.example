# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=Healthcare AI Service
APP_ENV=development
DEBUG=false

# ── Model Selection ───────────────────────────────────────────────────────
# "sklearn" = nhanh, nhẹ | "phobert" = chính xác hơn nhưng cần GPU
MODEL_TYPE=sklearn
MODEL_DIR=app/models

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.3

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
CACHE_TTL_SYMPTOM=3600
CACHE_TTL_RECOMMEND=1800

# ── JWT (phải khớp với Spring Auth Service) ───────────────────────────────
JWT_SECRET=your-jwt-secret-key-here
JWT_ALGORITHM=HS256

# ── Spring Services ───────────────────────────────────────────────────────
DOCTOR_SERVICE_URL=http://doctor-service:8083
APPOINTMENT_SERVICE_URL=http://appointment-service:8084
USER_SERVICE_URL=http://user-service:8082

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ai_user:password@localhost:5432/ai_db

# ── CORS ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_SYMPTOM=10
RATE_LIMIT_CHATBOT=20
RATE_LIMIT_RECOMMEND=30

# ── Confidence Thresholds ─────────────────────────────────────────────────
MIN_CONFIDENCE_THRESHOLD=0.15
URGENT_SEVERITY_THRESHOLD=8
